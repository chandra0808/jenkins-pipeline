pipeline {
    agent any
    tools {
        maven 'Maven3'
        jdk 'JDK8'
    }
    stages {
        stage('Checkout') {
            steps {
                git 'https://github.com/OT-MyGurukulam/spring3hibernate.git'
            }
        }
        stage('Parallel Execution') {
            parallel {
                stage('Check Java Version') {
                    steps {
                        sh 'java -version'
                    }
                }
                stage('Compile') {
                    steps {
                        sh 'echo "Compiling project..."'
                    }
                }
                
        stage('GitLeaks Scan') {
            steps {
                sh '''
                gitleaks detect \
                --source . \
                --report-format json \
                --report-path gitleaks-report.json \
                || true
                '''
            }
        }
        stage('Approval') {
            steps {
                input message: 'Proceed with Maven Build?',
                ok: 'Start Maven Build'
            }
        }
            }
        }
        stage('Maven Build') {
            steps {
                echo "Running Maven Test"
                sh 'mvn test'
                echo "Compiling through Maven"
                sh 'mvn compile'
            }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: 'gitleaks-report.json'
        }
    }
}
